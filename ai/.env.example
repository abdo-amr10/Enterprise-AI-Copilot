# AI Runtime configuration
# Copy this file to .env. Do not commit .env because it contains credentials.

# This is the Backend URL that the AI calls to retrieve source files and
# approved revisions. It is NOT the AI Runtime port (8000).
# Same machine example: http://localhost:5226
# Different machine example: https://<backend-ngrok-url>
BACKEND_API_BASE_URL=http://localhost:5226
# Local development only: allow the .NET self-signed HTTPS certificate.
BACKEND_ALLOW_INSECURE_LOCAL_HTTPS=true
# --- Authentication Option 1: Auto-Login (Recommended) ---
# The AI will log in automatically to the backend and manage/refresh JWT tokens seamlessly without manual copy-pasting.
BACKEND_SERVICE_EMAIL=admin@example.com
BACKEND_SERVICE_PASSWORD=YourPassword

# --- Authentication Option 2: Manual Bearer Token ---
# A valid service/JWT token accepted by the Backend (uncomment and use if you prefer manual token).
# BACKEND_SERVICE_BEARER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Request timeout in seconds for AI -> Backend calls.
BACKEND_API_TIMEOUT_SECONDS=200

