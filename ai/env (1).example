# =========================================================
# AI Runtime - Environment Variables
# انسخ الملف ده باسم ".env" في نفس المسار: D:\git\Enterprise-AI-Copilot\ai\
# واملي القيم الحقيقية بدل الـ placeholders
# =========================================================

# عنوان الـ Backend الحقيقي (لو الـ Backend شغّال على HTTPS أو port مختلف، غيّري هنا فقط)
BACKEND_API_BASE_URL=http://localhost:5226

# JWT أو Service Token صالح للـ Backend
BACKEND_SERVICE_BEARER_TOKEN=REPLACE_WITH_VALID_TOKEN

# نفس المفتاح اللي الـ Backend بيستخدمه عند استدعاء AI Runtime
AI_INTERNAL_API_KEY=REPLACE_WITH_SAME_KEY_AS_BACKEND
