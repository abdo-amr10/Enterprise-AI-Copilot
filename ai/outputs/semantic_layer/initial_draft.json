  "security": [
    {
      "table": "branches",
      "join_logic": "Contains branch_id directly",
      "enforced_sql": "WHERE branches.branch_id = @UserBranchId"
    },
    {
      "table": "accounts",
      "join_logic": "Contains branch_id directly",
      "enforced_sql": "WHERE accounts.branch_id = @UserBranchId"
    },
    {
      "table": "transactions",
      "join_logic": "Joined with accounts table via account_id",
      "enforced_sql": "INNER JOIN accounts ON transactions.account_id = accounts.account_id WHERE accounts.branch_id = @UserBranchId"
    },
    {
      "table": "cards",
      "join_logic": "Joined with accounts table via account_id",
      "enforced_sql": "INNER JOIN accounts ON cards.account_id = accounts.account_id WHERE accounts.branch_id = @UserBranchId"
    },
    {
      "table": "customers",
      "join_logic": "Joined with accounts table via customer_id",
      "enforced_sql": "INNER JOIN accounts ON customers.customer_id = accounts.customer_id WHERE accounts.branch_id = @UserBranchId"
    },
    {
      "table": "loans",
      "join_logic": "Joined with customers then accounts then branches",
      "enforced_sql": "INNER JOIN customers ON loans.customer_id = customers.customer_id INNER JOIN accounts ON customers.customer_id = accounts.customer_id INNER JOIN branches ON accounts.branch_id = branches.branch_id WHERE branches.branch_id = @UserBranchId"
    },
    {
      "table": "merchants",
      "join_logic": "Multiple joins with transactions then accounts",
      "enforced_sql": "INNER JOIN transactions ON merchants.merchant_id = transactions.merchant_id INNER JOIN accounts ON transactions.account_id = accounts.account_id WHERE accounts.branch_id = @UserBranchId"
    }
  ],
