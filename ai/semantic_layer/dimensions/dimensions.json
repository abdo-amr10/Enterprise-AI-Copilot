{
  "version": "1.0",
  "database": "Synthetic Banking Database",
  "source": [
    "schema.json",
    "business_glossary.md"
  ],
  "dimensions": [
    {
      "name": "Customer",
      "table": "customers",
      "columns": [
        "customer_id",
        "first_name",
        "last_name",
        "city",
        "credit_score",
        "created_at"
      ]
    },
    {
      "name": "Branch",
      "table": "branches",
      "columns": [
        "branch_id",
        "branch_name",
        "city",
        "country"
      ]
    },
    {
      "name": "Account",
      "table": "accounts",
      "columns": [
        "account_id",
        "customer_id",
        "branch_id",
        "account_type",
        "open_date"
      ]
    },
    {
      "name": "Card",
      "table": "cards",
      "columns": [
        "card_id",
        "account_id",
        "card_type",
        "expiration_date"
      ]
    },
    {
      "name": "Merchant",
      "table": "merchants",
      "columns": [
        "merchant_id",
        "merchant_name",
        "city"
      ]
    },
    {
      "name": "Transaction Date",
      "table": "transactions",
      "columns": [
        "transaction_date"
      ]
    },
    {
      "name": "Loan",
      "table": "loans",
      "columns": [
        "loan_id",
        "customer_id",
        "start_date",
        "interest_rate"
      ]
    }
  ]
}